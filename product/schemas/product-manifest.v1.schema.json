{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognicode.dev/schemas/product-manifest.v1.schema.json",
  "title": "CogniCode Product Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "version",
    "source_commit",
    "public_surface",
    "languages",
    "platforms",
    "artifacts",
    "feature_flags"
  ],
  "properties": {
    "schema_version": {
      "const": "cognicode.product/v1"
    },
    "product": {
      "const": "cognicode"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "public_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binaries",
        "profiles",
        "mcp"
      ],
      "properties": {
        "binaries": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "kind",
              "package",
              "support_level"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "package": {
                "type": "string"
              },
              "support_level": {
                "$ref": "#/$defs/support_level"
              }
            }
          }
        },
        "profiles": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "description",
              "mutating",
              "install",
              "stability"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "mutating": {
                "type": "boolean"
              },
              "install": {
                "type": "boolean"
              },
              "stability": {
                "enum": [
                  "stable",
                  "experimental"
                ]
              }
            }
          }
        },
        "mcp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "transport",
            "protocol_revision",
            "tool_catalog"
          ],
          "properties": {
            "transport": {
              "const": "stdio"
            },
            "protocol_revision": {
              "const": "2025-03-26"
            },
            "tool_catalog": {
              "const": "tools.json"
            }
          }
        }
      }
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/language_item"
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/platform_item"
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tools",
        "profiles",
        "languages",
        "platforms"
      ],
      "properties": {
        "tools": {
          "const": "tools.json"
        },
        "languages": {
          "const": "languages.json"
        },
        "platforms": {
          "const": "platforms.json"
        },
        "profiles": {
          "const": "profiles.json"
        }
      }
    },
    "feature_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_only_mode",
        "mutations",
        "telemetry_default",
        "network_default"
      ],
      "properties": {
        "read_only_mode": {
          "const": true
        },
        "mutations": {
          "const": "developer-explicit"
        },
        "telemetry_default": {
          "const": "off"
        },
        "network_default": {
          "const": "denied"
        }
      }
    }
  },
  "$defs": {
    "support_level": {
      "enum": [
        "certified",
        "supported",
        "experimental",
        "unsupported"
      ]
    },
    "language_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "support_level",
        "evidence"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "support_level": {
          "$ref": "#/$defs/support_level"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "platform_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "support_level",
        "evidence"
      ],
      "properties": {
        "target": {
          "type": "string"
        },
        "support_level": {
          "$ref": "#/$defs/support_level"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
