{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognicode.dev/schemas/languages.v1.schema.json",
  "title": "CogniCode language support matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product", "version", "source_commit", "languages"],
  "properties": {
    "schema_version": { "const": "cognicode.languages/v1" },
    "product": { "const": "cognicode" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/language" }
    }
  },
  "$defs": {
    "support_level": { "enum": ["certified", "supported", "experimental", "unsupported"] },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "support_level", "extensions", "reader", "not_asserted_by_generic_reader", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "support_level": { "$ref": "#/$defs/support_level" },
        "extensions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "reader": { "enum": ["generic", "semantic"] },
        "not_asserted_by_generic_reader": {
          "type": "array",
          "items": { "enum": ["function", "class", "variable", "call", "import"] }
        },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
