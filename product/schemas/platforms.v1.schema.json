{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognicode.dev/schemas/platforms.v1.schema.json",
  "title": "CogniCode platform support matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product", "version", "source_commit", "platforms"],
  "properties": {
    "schema_version": { "const": "cognicode.platforms/v1" },
    "product": { "const": "cognicode" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/platform" }
    }
  },
  "$defs": {
    "support_level": { "enum": ["certified", "supported", "experimental", "unsupported"] },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "name", "support_level", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "support_level": { "$ref": "#/$defs/support_level" },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
