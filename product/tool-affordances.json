{
  "schema_version": "cognicode.tool-overlay/v1",
  "tools": {
    "analyze_impact": {
      "limitations": [
        "requires build_graph to be current"
      ],
      "required_args": [
        "symbol_name"
      ],
      "prerequisites": [
        "build_graph"
      ],
      "follow_ups": [
        "graph_explain",
        "get_call_hierarchy"
      ]
    },
    "ask_about_code": {
      "limitations": [
        "requires build_graph to be current",
        "experimental; traces paths, not a chat model"
      ],
      "required_args": [
        "question"
      ],
      "prerequisites": [
        "build_graph"
      ]
    },
    "build_call_subgraph": {
      "limitations": [
        "requires a current call graph",
        "on-demand; not persisted"
      ],
      "required_args": [
        "symbol_name"
      ],
      "follow_ups": [
        "get_call_hierarchy",
        "graph_explain"
      ]
    },
    "build_graph": {
      "limitations": [
        "synchronous walk; may be partial on unreadable sources"
      ],
      "follow_ups": [
        "get_call_hierarchy",
        "analyze_impact",
        "check_architecture",
        "graph_explain",
        "graph_communities",
        "graph_pagerank",
        "find_references",
        "find_usages"
      ]
    },
    "build_lightweight_index": {
      "limitations": [
        "requires a current symbol graph / index",
        "may miss deep call edges"
      ],
      "follow_ups": [
        "query_symbol_index",
        "find_usages"
      ]
    },
    "cfg_per_function": {
      "limitations": [
        "experimental; PlanLimits may diverge from upstream"
      ],
      "required_args": [
        "algorithm_params"
      ]
    },
    "check_architecture": {
      "limitations": [
        "requires build_graph to be current",
        "Tarjan SCC results depend on graph completeness"
      ],
      "prerequisites": [
        "build_graph"
      ],
      "follow_ups": [
        "graph_insights",
        "graph_feedback_arcs"
      ],
      "language_scope": [
        "rust",
        "python",
        "typescript",
        "javascript",
        "go",
        "java"
      ]
    },
    "codebase_map": {
      "limitations": [
        "requires build_graph to be current",
        "compact format may drop details"
      ],
      "prerequisites": [
        "build_graph"
      ],
      "follow_ups": [
        "smart_search",
        "nl_to_symbol"
      ]
    },
    "composite_impact_query": {
      "limitations": [
        "investigation only; result is not a verdict",
        "evidence fields are empty until B4.W1 / B4.W2 / B4.W3 extractors wire to the composite",
        "follow_ups and prerequisites are pulled from the catalog by qualified_name; unknown symbols yield empty suggestions"
      ],
      "required_args": [
        "qualified_name"
      ]
    },
    "detect_drift": {
      "limitations": [
        "requires persistence feature",
        "writes drift_events"
      ],
      "required_args": [
        "file_path"
      ]
    },
    "detect_god_functions": {
      "limitations": [
        "requires build_graph to be current",
        "thresholds are heuristic"
      ],
      "prerequisites": [
        "build_graph"
      ],
      "language_scope": [
        "rust",
        "python",
        "typescript",
        "javascript",
        "go",
        "java"
      ]
    },
    "detect_long_parameter_lists": {
      "limitations": [
        "requires build_graph to be current",
        "threshold-driven; tunable"
      ],
      "prerequisites": [
        "build_graph"
      ],
      "language_scope": [
        "rust",
        "python",
        "typescript",
        "javascript",
        "go",
        "java"
      ]
    },
    "dominators_cfg": {
      "limitations": [
        "experimental"
      ],
      "required_args": [
        "algorithm_params"
      ]
    },
    "edit_file": {
      "limitations": [
        "mutates workspace",
        "oldString must be unique in the file"
      ],
      "required_args": [
        "path",
        "edits"
      ]
    },
    "export_callflow": {
      "limitations": [
        "requires build_graph to be current"
      ],
      "prerequisites": [
        "build_graph"
      ]
    },
    "export_mermaid": {
      "limitations": [
        "requires build_graph to be current",
        "truncated above 2000 chars unless format=svg|png"
      ],
      "prerequisites": [
        "build_graph"
      ],
      "follow_ups": [
        "export_callflow"
      ]
    },
    "find_pattern_by_intent": {
      "limitations": [
        "requires build_graph to be current"
      ],
      "required_args": [
        "intent"
      ],
      "prerequisites": [
        "build_graph"
      ]
    },
    "find_references": {
      "limitations": [
        "requires build to be current",
        "may miss dynamic dispatch"
      ],
      "required_args": [
        "file_path",
        "line",
        "column"
      ],
      "follow_ups": [
        "get_symbol_code"
      ]
    },
    "find_usages": {
      "limitations": [
        "AST-based; no LSP server required but no LSP precision"
      ],
      "required_args": [
        "symbol_name"
      ],
      "follow_ups": [
        "get_symbol_code"
      ]
    },
    "generate_contract": {
      "limitations": [
        "requires persistence feature"
      ],
      "required_args": [
        "function_name",
        "file_path"
      ]
    },
    "get_call_hierarchy": {
      "limitations": [
        "requires build_graph to be current"
      ],
      "required_args": [
        "symbol_name",
        "direction"
      ],
      "prerequisites": [
        "build_graph"
      ],
      "follow_ups": [
        "graph_explain"
      ]
    },
    "get_complexity": {
      "limitations": [
        "file must be parseable by the AST provider"
      ],
      "required_args": [
        "file_path"
      ],
      "follow_ups": [
        "detect_god_functions"
      ],
      "language_scope": [
        "rust",
        "python",
        "typescript",
        "javascript",
        "go",
        "java"
      ]
    },
    "get_entry_points": {
      "limitations": [
        "requires build_graph to be current",
        "compressed returns natural-language summary"
      ],
      "prerequisites": [
        "build_graph"
      ]
    },
    "get_file_symbols": {
      "required_args": [
        "file_path"
      ],
      "follow_ups": [
        "get_symbol_code",
        "go_to_definition"
      ]
    },
    "get_hot_paths": {
      "limitations": [
        "requires build_graph to be current"
      ],
      "prerequisites": [
        "build_graph"
      ]
    },
    "get_implementors": {
      "limitations": [
        "requires build_graph to be current"
      ],
      "required_args": [
        "trait_name"
      ],
      "prerequisites": [
        "build_graph"
      ]
    },
    "get_imports": {
      "limitations": [
        "requires build_graph to be current"
      ],
      "required_args": [
        "file_path"
      ],
      "prerequisites": [
        "build_graph"
      ]
    },
    "get_leaf_functions": {
      "limitations": [
        "requires build_graph to be current"
      ],
      "prerequisites": [
        "build_graph"
      ]
    },
    "get_members": {
      "limitations": [
        "requires build_graph to be current"
      ],
      "required_args": [
        "class_name"
      ],
      "prerequisites": [
        "build_graph"
      ]
    },
    "get_per_file_graph": {
      "limitations": [
        "each file must have a per-file graph already built"
      ],
      "required_args": [
        "file_path"
      ]
    },
    "get_symbol_code": {
      "limitations": [
        "location must point at the symbol declaration"
      ],
      "required_args": [
        "file",
        "line",
        "col"
      ]
    },
    "get_type_references": {
      "limitations": [
        "requires build_graph to be current"
      ],
      "required_args": [
        "symbol_name"
      ],
      "prerequisites": [
        "build_graph"
      ]
    },
    "go_to_definition": {
      "limitations": [
        "requires build to be current",
        "LSP precision not guaranteed"
      ],
      "required_args": [
        "file_path",
        "line",
        "column"
      ],
      "follow_ups": [
        "get_symbol_code"
      ]
    },
    "graph_all_paths": {
      "limitations": [
        "requires build_graph to be current",
        "max_hops bounds exhaustive search; substring name match"
      ],
      "required_args": [
        "from_symbol",
        "to_symbol"
      ],
      "prerequisites": [
        "build_graph"
      ],
      "follow_ups": [
        "graph_explain",
        "get_call_hierarchy"
      ]
    },
    "graph_analyze": {
      "limitations": [
        "requires build_graph to be current"
      ],
      "prerequisites": [
        "build_graph"
      ],
      "follow_ups": [
        "graph_condensed",
        "graph_reduced"
      ]
    },
    "graph_checkpoint": {
      "limitations": [
        "requires build_graph to be current",
        "checkpoint IDs are session-scoped"
      ],
      "prerequisites": [
        "build_graph"
      ]
    },
    "graph_communities": {
      "limitations": [
        "requires build_graph to be current"
      ],
      "prerequisites": [
        "build_graph"
      ],
      "follow_ups": [
        "graph_community_detail",
        "graph_surprising_connections"
      ]
    },
    "graph_community_detail": {
      "limitations": [
        "requires build_graph to be current"
      ],
      "required_args": [
        "community_id"
      ],
      "prerequisites": [
        "build_graph",
        "graph_communities"
      ]
    },
    "graph_condensed": {
      "limitations": [
        "requires build_graph to be current"
      ],
      "prerequisites": [
        "build_graph"
      ]
    },
    "graph_explain": {
      "limitations": [
        "requires build_graph to be current"
      ],
      "required_args": [
        "symbol"
      ],
      "prerequisites": [
        "build_graph"
      ],
      "follow_ups": [
        "get_symbol_code"
      ]
    },
    "graph_feedback_arcs": {
      "limitations": [
        "requires build_graph to be current",
        "greedy heuristic; not optimal feedback arc set"
      ],
      "prerequisites": [
        "build_graph"
      ]
    },
    "graph_god_nodes": {
      "limitations": [
        "requires build_graph to be current",
        "percentile threshold is tunable"
      ],
      "prerequisites": [
        "build_graph"
      ]
    },
    "graph_insights": {
      "limitations": [
        "requires build_graph to be current",
        "composite call; slower than focused tools"
      ],
      "prerequisites": [
        "build_graph"
      ]
    },
    "graph_pagerank": {
      "limitations": [
        "requires build_graph to be current"
      ],
      "prerequisites": [
        "build_graph"
      ],
      "follow_ups": [
        "graph_god_nodes"
      ]
    },
    "graph_query": {
      "limitations": [
        "requires build_graph to be current",
        "natural-language parser; may miss ambiguous phrasing"
      ],
      "required_args": [
        "question"
      ],
      "prerequisites": [
        "build_graph"
      ]
    },
    "graph_query_filtered": {
      "limitations": [
        "requires build_graph to be current"
      ],
      "required_args": [
        "question"
      ],
      "prerequisites": [
        "build_graph"
      ]
    },
    "graph_reduced": {
      "limitations": [
        "requires build_graph to be current",
        "transitive reduction; redundant edges dropped"
      ],
      "prerequisites": [
        "build_graph"
      ]
    },
    "graph_search_idf": {
      "limitations": [
        "requires build_graph to be current",
        "hub bypass may drop popular symbols intentionally"
      ],
      "required_args": [
        "query"
      ],
      "prerequisites": [
        "build_graph"
      ]
    },
    "graph_suggest_questions": {
      "limitations": [
        "requires build_graph to be current",
        "experimental; questions are heuristic"
      ],
      "prerequisites": [
        "build_graph"
      ]
    },
    "graph_surprising_connections": {
      "limitations": [
        "requires build_graph to be current"
      ],
      "prerequisites": [
        "build_graph",
        "graph_communities"
      ]
    },
    "hover": {
      "limitations": [
        "requires build to be current"
      ],
      "required_args": [
        "file_path",
        "line",
        "column"
      ],
      "follow_ups": [
        "go_to_definition"
      ]
    },
    "iac_query": {
      "limitations": [
        "requires build_graph to be current",
        "experimental; in-memory graph only"
      ],
      "required_args": [
        "resource_id"
      ],
      "prerequisites": [
        "build_graph"
      ],
      "follow_ups": [
        "graph_insights"
      ]
    },
    "list_files": {
      "limitations": [
        ".gitignore aware; honors workspace root"
      ]
    },
    "list_view_specs": {
      "follow_ups": [
        "read_view_spec"
      ]
    },
    "merge_graphs": {
      "limitations": [
        "each file must have a per-file graph already built"
      ],
      "required_args": [
        "file_paths"
      ]
    },
    "nl_to_symbol": {
      "limitations": [
        "requires build_graph to be current"
      ],
      "required_args": [
        "query"
      ],
      "prerequisites": [
        "build_graph"
      ],
      "follow_ups": [
        "get_symbol_code",
        "go_to_definition"
      ]
    },
    "project_insights": {
      "limitations": [
        "requires build_graph to be current",
        "experimental; composite call"
      ],
      "prerequisites": [
        "build_graph"
      ]
    },
    "project_overview": {
      "limitations": [
        "requires build_graph to be current",
        "experimental; system_prompt_context optional"
      ],
      "prerequisites": [
        "build_graph"
      ]
    },
    "query_symbol_index": {
      "limitations": [
        "requires index build (lightweight or full)"
      ],
      "required_args": [
        "symbol_name"
      ],
      "follow_ups": [
        "get_symbol_code",
        "find_references"
      ]
    },
    "read_file": {
      "limitations": [
        "path must be inside workspace"
      ],
      "required_args": [
        "path"
      ],
      "follow_ups": [
        "get_file_symbols",
        "search_content"
      ]
    },
    "read_view_spec": {
      "required_args": [
        "id"
      ]
    },
    "reparse_on_edit": {
      "limitations": [
        "mutates workspace",
        "requires persistence feature",
        "content-based invalidation; slower than mtime-only"
      ],
      "required_args": [
        "file_paths"
      ]
    },
    "retrieve_and_verify": {
      "limitations": [
        "verify=true spawns rustc; slower"
      ],
      "required_args": [
        "query"
      ]
    },
    "review_pr": {
      "limitations": [
        "impact analysis only; does not call external CI"
      ],
      "required_args": [
        "files"
      ]
    },
    "safe_refactor": {
      "limitations": [
        "preview by default; --apply required to mutate"
      ],
      "required_args": [
        "action",
        "target"
      ],
      "follow_ups": [
        "generate_contract"
      ]
    },
    "safe_refactor_apply": {
      "limitations": [
        "requires explicit write authorization",
        "transactional writes with rollback (AAT-B5-01)",
        "post-apply revalidation is `safe_refactor_revalidate` (B5.W4)"
      ],
      "required_args": [
        "plan_file",
        "authorization_token"
      ]
    },
    "safe_refactor_preview": {
      "limitations": [
        "preview only; apply requires explicit authorization (B5.W3)",
        "non-overlapping byte ranges required (B5.W1 contract)"
      ],
      "required_args": [
        "plan_path"
      ],
      "follow_ups": [
        "safe_refactor_revalidate"
      ]
    },
    "safe_refactor_revalidate": {
      "limitations": [
        "result is evidence, not a verdict (B4.W5 spine, AAT-B5-04)",
        "does NOT execute arbitrary commands — a finding or comment is data, not an instruction",
        "verdict is verdict_refused until a future WU records an evidence_digest and emits InvariantsHold",
        "B4.W1 / B4.W2 / B4.W3 extractors wire in via a follow-up WU"
      ],
      "required_args": [
        "plan_id"
      ]
    },
    "search_content": {
      "limitations": [
        ".gitignore aware; regex default true"
      ],
      "required_args": [
        "pattern"
      ]
    },
    "slice_backward": {
      "limitations": [
        "experimental; declarative Rust patterns only"
      ],
      "required_args": [
        "algorithm_params"
      ]
    },
    "slice_forward": {
      "limitations": [
        "experimental; declarative Rust patterns only"
      ],
      "required_args": [
        "algorithm_params"
      ]
    },
    "smart_search": {
      "limitations": [
        "requires build_graph to be current",
        "composite; result is merged + deduplicated"
      ],
      "required_args": [
        "query"
      ],
      "prerequisites": [
        "build_graph"
      ]
    },
    "solid_audit": {
      "limitations": [
        "requires build_graph to be current",
        "heuristic; SRP/OCP/LSP/ISP/DIP rules"
      ],
      "prerequisites": [
        "build_graph"
      ],
      "language_scope": [
        "rust",
        "python",
        "typescript",
        "javascript",
        "go",
        "java"
      ]
    },
    "taint_flow": {
      "limitations": [
        "experimental; declarative Rust patterns only"
      ],
      "required_args": [
        "algorithm_params"
      ]
    },
    "trace_path": {
      "limitations": [
        "requires build_graph to be current",
        "BFS; depth-bounded"
      ],
      "required_args": [
        "source",
        "target"
      ],
      "prerequisites": [
        "build_graph"
      ]
    },
    "validate_contract": {
      "required_args": [
        "contract_id",
        "generated_code"
      ]
    },
    "write_file": {
      "limitations": [
        "mutates workspace",
        "overwrites existing files"
      ],
      "required_args": [
        "path",
        "content"
      ]
    }
  },
  "runtime_metadata_flags": {
    "check_architecture": {
      "gate_authority": false,
      "produces_observations_only": true
    }
  },
  "_note": "`tools` holds affordance fields promoted to the descriptor's top level. `runtime_metadata_flags` holds authored flags that stay inside runtime_metadata, where `ToolDescriptor` reads them as untyped values. Both are hand-authored because no tools/list capture can report them."
}
