@language groovy
# Hand-written from the sources: the types and callables each file declares,
# as `class|function <name>@<path relative to this directory>`. Variables,
# fields and the synthetic <script> entry are not part of the contract.
# A Jenkinsfile and a build.gradle declare nothing of their own: a stage is a
# declaration, not a function. The top-level `call` of `vars/<step>.groovy` is
# the step `<step>`.
class Kube@src/org/acme/Kube.groovy
function Kube@src/org/acme/Kube.groovy
function apply@src/org/acme/Kube.groovy
function rollback@src/org/acme/Kube.groovy
function deploy@vars/deploy.groovy
function notify@vars/notify.groovy
function failed@vars/notify.groovy
