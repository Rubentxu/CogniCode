# CogniCode TypeScript Sandbox — Hardened Quadlet
[Unit]
Description=CogniCode TypeScript Sandbox (Hardened)
RequiresMountsFor=%t/containers

[Container]
# Keep-alive — sandbox exec target (accepts podman exec while active)
Exec=sleep infinity
# Pinned image digest — obtained via podman pull + podman inspect
Image=docker.io/library/node:22-slim@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436
ContainerName=cognicode-ts
Volume=cognicode-ts-workspace.volume:/workspace:z
Volume=%h/Proyectos/rust/CogniCode/sandbox/repos:/repos:z
# Host path assumes local layout; CI bridges it via symlink (sandbox-nightly.yml "Prepare host layout")
Environment=COGNICODE_WORKSPACE=/workspace
# Isolation: no host network
Network=none
# Resource limits
PidsLimit=64
# Read-only root filesystem
ReadOnly=yes
# Tmpfs for /tmp (writable but ephemeral)
Tmpfs=/tmp:rw,noexec,nosuid,size=64m
# Security: no new privileges
NoNewPrivileges=yes
# Cache volumes for node_modules (mount read-write only to cache dirs)
# Volume=%t/containers/cognicode-ts-npm-cache:/root/.npm:z

[Service]
CPUWeight=50
# Resource limits (systemd-native keys — [Container] MemoryMax unsupported by quadlet)
MemoryMax=1G
MemorySwapMax=1G
Restart=on-failure
# AutoUpdate disabled — must pin digest before enabling
AutoUpdate=no
TimeoutStopSec=30

[Install]
WantedBy=default.target
