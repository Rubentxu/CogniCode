[Unit]
Description=Publish the CogniCode SDK version declared on main when crates.io lacks it

[Service]
Type=oneshot
# sdk-release.env (operator-owned, mode 600) defines COGNICODE_CHECKOUT, a clean
# checkout of main used only by this unit, and may export CARGO_REGISTRY_TOKEN.
# This unit holds no credential and never tags.
EnvironmentFile=%h/.config/cognicode/sdk-release.env
ExecStart=/bin/bash -c 'cd "$$COGNICODE_CHECKOUT" && exec bash scripts/distribution/auto-release-sdk.sh'
Nice=10
TimeoutStartSec=1h
